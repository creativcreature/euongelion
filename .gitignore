# Generated AI image batches (multi-GB, regenerated on demand)
public/images/generated-*/

# Image library staging tree (deduped from generated batches via
# scripts/consolidate-image-library.mjs — staging, not served).
# The catalog (docs/image-library-catalog-*.json) and index doc
# (docs/image-library-index-*.md) ARE tracked.
public/images/library/

# Reference library (13GB — stored in Supabase Storage)
content/reference/bibles/
content/reference/commentaries/
content/reference/dictionaries/
content/reference/lexicons/
content/reference/stepbible-data/

# Build-generated reference index — MUST be committed so Vercel can use it.
# Generated by: node scripts/build-reference-index-final.mjs
# Contains verified theological commentary chunks for the 80/20 RAG pipeline.
# Without this file, devotionals on production have NO reference grounding.
# public/reference-index.json  ← INTENTIONALLY NOT IGNORED

# Build-generated lexicon index — MUST be committed (the source XML lexica under
# content/reference/lexicons/ + stepbible-data/ are gitignored, so they are
# unavailable on CI/Cloudflare Workers). Regenerate after a lexicon update with:
#   npm run build:lexicon-index
# Lets src/lib/soul-audit/lexicon.ts do pure JSON lookups at runtime instead of
# parsing ~27 MB of XML (which blows the Workers 10 ms CPU budget).
# public/lexicon-strongs.json  ← INTENTIONALLY NOT IGNORED
# public/lexicon-verses.json   ← INTENTIONALLY NOT IGNORED

# Artwork source files (blue woodprint generated from these)
public/images/devotional-prints/*/raw.jpg

# Claude Code local files (agents/ and skills/ ARE tracked)
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/
.claude/plans/

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Supabase
supabase/.temp/

# Keys
*.pem
.env*.local

# Design scratch / source art — never commit or deploy.
# .psd files (67-83MB) exceed Cloudflare Workers' 25 MiB per-file asset limit
# and would break the deploy if served from public/. These are editing sources,
# not shipped assets. Relocated out of public/ to design-sources/.
*.psd
public/images/edit/
design-sources/

# Founder marketing/strategy scratch (not app assets; kept local)
marketing/
social-plan/
